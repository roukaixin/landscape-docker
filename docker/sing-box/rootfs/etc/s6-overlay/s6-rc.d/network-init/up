#!/usr/bin/execlineb -S0

with-contenv
multisubstitute {
    importas -S -D false LAND_PROXY_ENABLE_ICMP_PASSTHROUGH
    importas -S -D 0x2 LAND_PROXY_ICMP_MARK_VALUE
}

foreground { ip rule add fwmark 0x1/0x1 lookup 100 }
foreground { ip route add local default dev lo table 100 }
foreground { ip -6 rule add fwmark 0x1 lookup 106 }
foreground { ip -6 route add local ::/0 dev lo table 106 }

foreground { echo 1 > /proc/sys/net/ipv4/ip_forward }
foreground { echo 1 > /proc/sys/net/ipv6/conf/all/forwarding }

foreground {
    if { eltest ${LAND_PROXY_ENABLE_ICMP_PASSTHROUGH} = true }
    iptables -t nat -A POSTROUTING -m mark --mark ${LAND_PROXY_ICMP_MARK_VALUE}/${LAND_PROXY_ICMP_MARK_VALUE} -j MASQUERADE
}
foreground {
    if { eltest ${LAND_PROXY_ENABLE_ICMP_PASSTHROUGH} = true }
    ip6tables -t nat -A POSTROUTING -m mark --mark ${LAND_PROXY_ICMP_MARK_VALUE}/${LAND_PROXY_ICMP_MARK_VALUE} -j MASQUERADE
}
